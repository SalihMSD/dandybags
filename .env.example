# Required for customer/admin sessions (use a long random string in production)
AUTH_SECRET=replace-with-a-long-random-secret

# Admin is created on first server start. There is no public admin registration.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Cloud PostgreSQL for Prisma. Use a development database locally.
# Never commit the real URL. Put it only in .env.local.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Direct database connection for Prisma (used for migrations/introspection).
# Often the same as DATABASE_URL; required when using Supabase pooled connections.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Used in verification and password-reset links
APP_URL=http://localhost:3000

# Optional — when these are set, verification and reset emails are sent for real
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=DANDY <your-gmail@gmail.com>

# Razorpay TEST MODE only. Real values belong in .env.local — never commit them.
# rzp_test_stub is a local E10-A stand-in so server tests can run without dashboard keys.
# Replace with real rzp_test_ keys before opening Razorpay Checkout in the browser.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-secret
# Razorpay Webhook secret — set in the Razorpay dashboard under Webhooks → Secret.
# Real value belongs only in .env.local — never commit it.
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
