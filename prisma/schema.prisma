generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum TokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum CouponStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum ShareRewardType {
  STORY_5
  STORY_AND_POST_10
}

enum ShareRewardStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String        @id
  fullName      String
  email         String        @unique
  phone         String        @unique
  passwordHash  String
  role          Role
  status        AccountStatus @default(ACTIVE)
  emailVerified Boolean       @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  addresses Address[]
  cart      Cart?
  wishlist  Wishlist[]
  orders    Order[]
  sessions  Session[]
  tokens    AuthToken[]
  reviews   Review[]
  helpfulVotes ReviewHelpful[]
  coupons   Coupon[]
  shareRewards ShareReward[]

  @@index([role])
  @@map("users")
}

model Address {
  id        String  @id
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  line1     String
  line2     String  @default("")
  city      String
  state     String
  pincode   String
  landmark  String  @default("")
  isDefault Boolean @default(false)

  @@index([userId])
  @@map("addresses")
}

model Cart {
  id        String     @id
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id      String  @id
  cartId  String
  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku     String
  product Product @relation(fields: [sku], references: [sku], onDelete: Restrict)
  qty     Int

  @@unique([cartId, sku])
  @@index([sku])
  @@map("cart_items")
}

model Wishlist {
  id      String   @id
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku     String
  product Product  @relation(fields: [sku], references: [sku], onDelete: Restrict)
  addedAt DateTime @default(now())

  @@unique([userId, sku])
  @@index([sku])
  @@map("wishlists")
}

model Order {
  id            String        @id
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  totalLabel    String
  paymentStatus PaymentStatus @default(PENDING)
  orderStatus   OrderStatus   @default(PLACED)
  shipFullName  String
  shipPhone     String
  shipLine1     String
  shipLine2     String        @default("")
  shipCity      String
  shipState     String
  shipPincode   String
  shipLandmark  String        @default("")
  shippingProvider String?
  trackingNumber   String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  razorpayOrderId    String?  @unique
  razorpayPaymentId  String?
  couponId           String?
  coupon             Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String   @id
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku       String
  slug      String
  name      String
  qty       Int
  image     String
  unitPrice Decimal? @db.Decimal(10, 2)

  @@index([orderId])
  @@index([sku])
  @@map("order_items")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthToken {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model Product {
  id             String   @id
  sku            String   @unique
  slug           String   @unique
  name           String
  /// One of: school-bags, college-bags, backpacks, travel-bags, sling-bags, handbags, ladies-purses
  category       String
  subcategory    String
  imageFront     String
  imageBack      String?
  imageLeft      String?
  imageRight     String?
  imageTop       String?
  imageBottom    String?
  imageInside    String?
  imageZipper    String?
  imageStrap     String?
  imageLifestyle String?
  colour         String
  material       String
  weight         String
  length         String
  width          String
  height         String
  capacity       String
  compartments   String
  features       String[]
  mrp            Decimal? @db.Decimal(10, 2)
  sellingPrice   Decimal? @db.Decimal(10, 2)
  discountPercent Int      @default(0)
  stock          Int?
  b2cAvailable   Boolean  @default(true)
  featured       Boolean  @default(false)
  description    String
  seoTitle       String
  seoDescription String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cartItems      CartItem[]
  wishlist       Wishlist[]
  reviews        Review[]

  @@index([category])
  @@index([featured])
  @@map("products")
}

model Review {
  id               String        @id
  productSku       String
  product          Product       @relation(fields: [productSku], references: [sku], onDelete: Cascade)
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating           Int
  title            String
  comment          String
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus  @default(PENDING)
  helpfulCount     Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  helpfulVotes     ReviewHelpful[]

  @@unique([productSku, userId])
  @@index([productSku, status, createdAt])
  @@index([userId])
  @@map("reviews")
}

model ReviewHelpful {
  id        String   @id
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@map("review_helpful")
}

model Coupon {
  id                 String        @id
  code               String        @unique
  discountType       CouponDiscountType
  discountValue      Decimal       @db.Decimal(10, 2)
  minimumOrderValue  Decimal?      @db.Decimal(10, 2)
  maximumDiscount    Decimal?      @db.Decimal(10, 2)
  usageLimit         Int
  usedCount          Int           @default(0)
  validFrom          DateTime
  validUntil         DateTime
  isActive           Boolean       @default(true)
  userId             String?
  user               User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  status             CouponStatus  @default(ACTIVE)
  usedAt             DateTime?
  shareReward        ShareReward?
  orders             Order[]
  sourceOrderId      String?
  sourceBillAmount   Decimal?      @db.Decimal(10, 2)
  rewardPercentage   Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([code])
  @@index([userId])
  @@index([status])
  @@map("coupons")
}

model ShareReward {
  id                String            @id
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId           String
  rewardType        ShareRewardType
  status            ShareRewardStatus @default(PENDING)
  storyProofUrl     String?
  postProofUrl      String?
  instagramUsername String
  taggedAccount     String            @default("@dandybagsonline.in")
  submittedAt       DateTime          @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?
  couponId          String?           @unique
  coupon            Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  rejectionReason   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@map("share_rewards")
}
