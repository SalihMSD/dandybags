generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String          @id
  fullName        String
  email           String          @unique
  phone           String          @unique
  passwordHash    String
  role            Role
  status          AccountStatus   @default(ACTIVE)
  emailVerified   Boolean         @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  phoneVerifiedAt DateTime?
  addresses       Address[]
  tokens          AuthToken[]
  cart            Cart?
  coupons         Coupon[]
  orders          Order[]
  returnRequests  ReturnRequest[]
  helpfulVotes    ReviewHelpful[]
  reviews         Review[]
  sessions        Session[]
  shareRewards    ShareReward[]
  wishlist        Wishlist[]

  @@index([role])
  @@map("users")
}

model Address {
  id        String  @id
  userId    String
  fullName  String
  phone     String
  line1     String
  line2     String  @default("")
  city      String
  state     String
  pincode   String
  landmark  String  @default("")
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Cart {
  id        String     @id
  userId    String     @unique
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id      String  @id
  cartId  String
  sku     String
  qty     Int
  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [sku], references: [sku])

  @@unique([cartId, sku])
  @@index([sku])
  @@map("cart_items")
}

model Wishlist {
  id      String   @id
  userId  String
  sku     String
  addedAt DateTime @default(now())
  product Product  @relation(fields: [sku], references: [sku])
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sku])
  @@index([sku])
  @@map("wishlists")
}

model Order {
  id                String          @id
  userId            String
  totalLabel        String
  paymentStatus     PaymentStatus   @default(PENDING)
  orderStatus       OrderStatus     @default(PLACED)
  shipFullName      String
  shipPhone         String
  shipLine1         String
  shipLine2         String          @default("")
  shipCity          String
  shipState         String
  shipPincode       String
  shipLandmark      String          @default("")
  shipEmail         String?
  shipCountry       String          @default("India")
  shippingProvider  String?
  trackingNumber    String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  razorpayOrderId   String?         @unique
  razorpayPaymentId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  couponId          String?
  items             OrderItem[]
  coupon            Coupon?         @relation(fields: [couponId], references: [id])
  user              User            @relation(fields: [userId], references: [id])
  refund            Refund?
  returnRequests    ReturnRequest[]
  shipment          Shipment?

  @@index([userId, createdAt])
  @@map("orders")
}

model Shipment {
  id                 String          @id
  orderId            String          @unique
  provider           String          @default("SHIPROCKET")
  providerOrderId    String?         @unique
  providerShipmentId String?
  awb                String?         @unique
  courierName        String?
  status             ShipmentStatus  @default(PENDING)
  trackingUrl        String?
  shippingCost       Decimal?        @db.Decimal(10, 2)
  labelUrl           String?
  pickupScheduledAt  DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  failureReason      String?
  idempotencyKey     String          @unique
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events             ShipmentEvent[]

  @@index([status])
  @@index([providerOrderId])
  @@index([awb])
  @@map("shipments")
}

model ShipmentEvent {
  id         String         @id
  shipmentId String
  status     ShipmentStatus
  rawStatus  String
  activity   String?
  location   String?
  note       String?
  occurredAt DateTime
  createdAt  DateTime       @default(now())
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@index([status, occurredAt])
  @@map("shipment_events")
}

enum ShipmentStatus {
  PENDING
  CREATED
  AWB_ASSIGNED
  PICKUP_SCHEDULED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  NDR
  RTO
  CANCELLED
  FAILED
  RECONCILIATION_REQUIRED
}

model Notification {
  id        String           @id
  type      NotificationType
  orderId   String
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@unique([orderId, type])
  @@index([read, createdAt])
  @@map("notifications")
}

model Refund {
  id                String         @id
  orderId           String         @unique
  razorpayPaymentId String
  razorpayRefundId  String?        @unique
  idempotencyKey    String         @unique
  amount            Int
  currency          String         @default("INR")
  status            RefundStatus   @default(PENDING)
  failureReason     String?
  requestedAt       DateTime       @default(now())
  completedAt       DateTime?
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnRequest     ReturnRequest?

  @@index([status])
  @@index([orderId])
  @@index([razorpayPaymentId])
  @@map("refunds")
}

model ReturnRequest {
  id                 String              @id
  orderId            String
  userId             String
  status             ReturnStatus        @default(REQUESTED)
  resolution         ReturnResolution
  reason             String
  note               String?
  /// only set when resolution = REFUND, in paise
  refundAmount       Int?
  refundId           String?             @unique
  /// target SKU for REPLACE/EXCHANGE
  exchangeVariantSku String?
  adminNote          String?
  processedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt
  items              ReturnRequestItem[]
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refund             Refund?             @relation(fields: [refundId], references: [id])
  user               User                @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([resolution])
  @@map("return_requests")
}

model ReturnRequestItem {
  id              String        @id
  returnRequestId String
  sku             String
  qty             Int
  /// e.g. "unused", "damaged", "worn"
  condition       String?
  reason          String?
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [sku], references: [sku])

  @@index([returnRequestId])
  @@index([sku])
  @@map("return_request_items")
}

model OrderItem {
  id        String   @id
  orderId   String
  sku       String
  slug      String
  name      String
  qty       Int
  image     String
  unitPrice Decimal? @db.Decimal(10, 2)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([sku])
  @@map("order_items")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthToken {
  id        String    @id
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model Product {
  id                 String              @id
  sku                String              @unique
  slug               String              @unique
  name               String
  /// One of: school-bags, college-bags, backpacks, travel-bags, sling-bags, handbags, ladies-purses
  category           String
  subcategory        String
  imageFront         String
  imageBack          String?
  imageLeft          String?
  imageRight         String?
  imageTop           String?
  imageBottom        String?
  imageInside        String?
  imageZipper        String?
  imageStrap         String?
  imageLifestyle     String?
  colour             String
  material           String
  weight             String
  length             String
  width              String
  height             String
  capacity           String
  compartments       String
  features           String[]
  mrp                Decimal?            @db.Decimal(10, 2)
  sellingPrice       Decimal?            @db.Decimal(10, 2)
  stock              Int?
  b2cAvailable       Boolean             @default(true)
  featured           Boolean             @default(false)
  description        String
  seoTitle           String
  seoDescription     String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  discountPercent    Int                 @default(0)
  cartItems          CartItem[]
  returnRequestItems ReturnRequestItem[]
  reviews            Review[]
  wishlist           Wishlist[]

  @@index([category])
  @@index([featured])
  @@map("products")
}

model Review {
  id               String          @id
  productSku       String
  userId           String
  rating           Int
  title            String
  comment          String
  verifiedPurchase Boolean         @default(false)
  status           ReviewStatus    @default(PENDING)
  helpfulCount     Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  helpfulVotes     ReviewHelpful[]
  product          Product         @relation(fields: [productSku], references: [sku], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productSku, userId])
  @@index([productSku, status, createdAt])
  @@index([userId])
  @@map("reviews")
}

model ReviewHelpful {
  id        String   @id
  reviewId  String
  userId    String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@map("review_helpful")
}

model Coupon {
  id                String             @id
  code              String             @unique
  discountType      CouponDiscountType
  discountValue     Decimal            @db.Decimal(10, 2)
  minimumOrderValue Decimal?           @db.Decimal(10, 2)
  maximumDiscount   Decimal?           @db.Decimal(10, 2)
  usageLimit        Int                @default(1)
  usedCount         Int                @default(0)
  validFrom         DateTime
  validUntil        DateTime
  isActive          Boolean            @default(true)
  userId            String?
  status            CouponStatus       @default(ACTIVE)
  usedAt            DateTime?
  shareRewardId     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sourceOrderId     String?
  sourceBillAmount  Decimal?           @db.Decimal(10, 2)
  rewardPercentage  Int?
  user              User?              @relation(fields: [userId], references: [id])
  orders            Order[]
  shareReward       ShareReward?

  @@index([code])
  @@index([userId])
  @@index([status])
  @@map("coupons")
}

model ShareReward {
  id                String            @id
  userId            String
  orderId           String
  rewardType        ShareRewardType
  status            ShareRewardStatus @default(PENDING)
  storyProofUrl     String?
  postProofUrl      String?
  instagramUsername String
  taggedAccount     String            @default("@dandybagsonline.in")
  submittedAt       DateTime          @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?
  couponId          String?           @unique
  rejectionReason   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  coupon            Coupon?           @relation(fields: [couponId], references: [id])
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@map("share_rewards")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum TokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum NotificationType {
  NEW_ORDER
  REFUND_SUCCEEDED
  REFUND_FAILED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_REJECTED
}

enum ReturnResolution {
  REFUND
  REPLACE
  EXCHANGE
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum CouponStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum ShareRewardType {
  STORY_5
  STORY_AND_POST_10
}

enum ShareRewardStatus {
  PENDING
  APPROVED
  REJECTED
}
